# Server Configuration
PORT=4000
NODE_ENV=development

# MySQL Database (Connecting to AaharIN POS database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=aahar_pos_db

# Security & JWT Token Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=30d

# Cloud Sync API Authentication Key
DEFAULT_SYNC_API_KEY=aaharin_firm_master_token_2026
